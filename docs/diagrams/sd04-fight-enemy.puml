@startuml sd04-fight-enemy
!include seq-style.iuml
title SD04 — Fight Enemy (UC04, F04; Command, State)

actor "Player" as P
boundary "__:SwingGameView__" as V
control "__:GameController__" as GC
participant "__:RulesEngine__" as RE
participant "__attack : AttackCommand__" as C
participant "__:GameState__" as GS
participant "__location : Location__" as L
participant "__:DiceRoller__" as D
participant "__player : Player__" as PL
participant "__wolf : Enemy__" as E
participant "__combatMode : CombatMode__" as CM
participant "__explorationMode : ExplorationMode__" as EM
participant "__:GameEventBus__" as BUS

P -> V : type "attack the wolf"
V -> GC : submitCommand(text)
ref over GC, RE : SD02 — interpret() (SD00) returns an ATTACK proposal;\nCommandFactory.create() returns attack (targetName = "wolf")
GC -> RE : executeAll([attack], state)
ref over RE, C : SD03 — mode check (allows) and attack.validate()
RE -> C : execute(state, rules)
  C -> GS : currentLocation()
  GS -->> C : location
  C -> L : findEnemy(targetName)
  L -->> C : wolf
  C -> GS : getPlayer()
  GS -->> C : player
  C -> GS : getMode()
  GS -->> C : mode
  opt mode is not a CombatMode
    C -> CM ** : <<create>> CombatMode(wolf)
    C -> GS : setMode(combatMode)
    GS -->> C
  end
  C -> RE : resolveAttack(player, wolf)
    RE -> D : rollD20()
    D -->> RE : roll
    RE -> PL : attackBonus()
    PL -->> RE : bonus
    RE -> E : defense()
    E -->> RE : defense
    opt roll + bonus ≥ defense
      RE -> PL : damage()
      PL -->> RE : damage
      RE -> E : takeDamage(damage)
      E -->> RE
    end
  RE -->> C : playerAttack : ActionResult
  C -> E : isAlive()
  E -->> C : alive
  alt wolf defeated
    C -> L : removeEnemy(wolf)
    L -->> C
    C -> EM ** : <<create>> ExplorationMode()
    C -> GS : setMode(explorationMode)
    GS -->> C
  else wolf still alive: enemy's turn
    C -> RE : resolveAttack(wolf, player)
      RE -> D : rollD20()
      D -->> RE : roll
      RE -> E : attackBonus()
      E -->> RE : bonus
      RE -> PL : defense()
      PL -->> RE : defense
      opt roll + bonus ≥ defense
        RE -> E : damage()
        E -->> RE : damage
        RE -> PL : takeDamage(damage)
        PL -->> RE
      end
    RE -->> C : enemyAttack : ActionResult
    C -> PL : isAlive()
    PL -->> C : playerAlive
    note right of C : if playerAlive is false, a COMBAT\n"player died" event is added to the result
  end
C -->> RE : result : ActionResult
note right of RE : result holds COMBAT events, e.g.\n"wolf defeated" or "player died"
loop for each event in result.getEvents()
  RE -> BUS : publish(event)
  ref over BUS : SD05
  BUS -->> RE
end
RE -->> GC : results
ref over V, GC : SD02 — narrate(results) (SD00), isGameOver() and showNarration();\nif the player died, endGame() (SD09)
GC -->> V : turnResult
V -->> P
@enduml
