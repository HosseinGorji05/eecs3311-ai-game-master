  <element>
    <id>UMLClass</id>
    <coordinates><x>410</x><y>990</y><w>340</w><h>120</h></coordinates>
    <panel_attributes>&lt;&lt;Caretaker&gt;&gt;
*SaveManager*
--
- saveDirectory: Path
--
+ save(slot: String, snapshot: GameSnapshot)
+ load(slot: String): GameSnapshot
+ listSlots(): List&lt;SaveSlotInfo&gt;</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>870</x><y>940</y><w>590</w><h>230</h></coordinates>
    <panel_attributes>&lt;&lt;Memento&gt;&gt;
*GameSnapshot*
--
_- CURRENT_VERSION: int = 1_
- version: int
- createdAt: Instant
- characterName: String
- locationName: String
- stateJson: String
--
+ GameSnapshot(stateJson: String, characterName: String, locationName: String)
_+ fromJson(json: String): GameSnapshot_
+ toJson(): String
+ isCompatible(): boolean
+ toSlotInfo(slot: String): SaveSlotInfo</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>610</x><y>1240</y><w>650</w><h>120</h></coordinates>
    <panel_attributes>*SaveSlotInfo*
--
- slot: String
- characterName: String
- locationName: String
- savedAt: Instant
--
+ SaveSlotInfo(slot: String, characterName: String, locationName: String, savedAt: Instant)</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
