  <element>
    <id>UMLClass</id>
    <coordinates><x>330</x><y>120</y><w>360</w><h>170</h></coordinates>
    <panel_attributes>*QuestLog*
--
_- MAX_SIDE_QUESTS: int = 3_
- quests: List&lt;Quest&gt;
--
+ accept(quest: Quest): boolean
+ activeQuests(): List&lt;Quest&gt;
+ activeSideQuestCount(): int
+ hasQuestFrom(giver: NPC): boolean
+ canOfferFrom(giver: NPC): boolean
--
/{activeSideQuestCount() ≤ MAX_SIDE_QUESTS}/</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>750</x><y>150</y><w>230</w><h>100</h></coordinates>
    <panel_attributes>&lt;&lt;ConcreteObserver&gt;&gt;
*QuestTracker*
--
- state: GameState
- eventBus: GameEventBus
--
+ onEvent(event: GameEvent)</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>310</x><y>360</y><w>260</w><h>250</h></coordinates>
    <panel_attributes>*Quest*
--
- id: String
- title: String
- description: String
- giverId: String
- main: boolean
- status: QuestStatus
- objectives: List&lt;Objective&gt;
- reward: Reward
--
+ getObjectives(): List&lt;Objective&gt;
+ getReward(): Reward
+ isComplete(): boolean
+ complete()
+ fail()</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>680</x><y>400</y><w>320</w><h>170</h></coordinates>
    <panel_attributes>*Objective*
--
- type: ObjectiveType
- targetId: String
- required: int
- progress: int
--
+ matches(event: GameEvent): boolean
+ isBlockedBy(event: GameEvent): boolean
+ advance()
+ isDone(): boolean</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>370</x><y>680</y><w>150</w><h>100</h></coordinates>
    <panel_attributes>&lt;&lt;enumeration&gt;&gt;
*QuestStatus*
--
ACTIVE
COMPLETED
FAILED</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>570</x><y>690</y><w>160</w><h>80</h></coordinates>
    <panel_attributes>*Reward*
--
- gold: int
- xp: int
- itemName: String</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>780</x><y>680</y><w>150</w><h>100</h></coordinates>
    <panel_attributes>&lt;&lt;enumeration&gt;&gt;
*ObjectiveType*
--
FETCH
DEFEAT
VISIT</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>1180</x><y>140</y><w>230</w><h>80</h></coordinates>
    <panel_attributes>&lt;&lt;interface&gt;&gt;
&lt;&lt;Observer&gt;&gt;
/*GameEventListener*/
--
+ onEvent(event: GameEvent)</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>1540</x><y>120</y><w>330</w><h>120</h></coordinates>
    <panel_attributes>&lt;&lt;Subject&gt;&gt;
*GameEventBus*
--
- listeners: List&lt;GameEventListener&gt;
--
+ subscribe(listener: GameEventListener)
+ unsubscribe(listener: GameEventListener)
+ publish(event: GameEvent)</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>1260</x><y>310</y><w>320</w><h>140</h></coordinates>
    <panel_attributes>&lt;&lt;ConcreteObserver&gt;&gt;
*EventLog*
--
- events: List&lt;GameEvent&gt;
--
+ onEvent(event: GameEvent)
+ filter(type: EventType): List&lt;GameEvent&gt;
+ recent(count: int): List&lt;GameEvent&gt;
- append(event: GameEvent)</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>1640</x><y>310</y><w>150</w><h>150</h></coordinates>
    <panel_attributes>&lt;&lt;enumeration&gt;&gt;
*EventType*
--
MOVEMENT
ITEM
COMBAT
DIALOGUE
QUEST
REJECTED</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>1180</x><y>530</y><w>700</w><h>220</h></coordinates>
    <panel_attributes>*GameEvent*
--
- type: EventType
- turn: int
- timestamp: Instant
- description: String
- subjectId: String
- alignmentDelta: int
--
+ GameEvent(type: EventType, turn: int, description: String, subjectId: String, alignmentDelta: int)
+ getType(): EventType
+ getTurn(): int
+ getDescription(): String
+ getAlignmentDelta(): int</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>140</x><y>940</y><w>60</w><h>30</h></coordinates>
