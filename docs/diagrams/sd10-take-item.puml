@startuml sd10-take-item
!include seq-style.iuml
title SD10 — Take an Item with an Inventory Button (UC05, F05; Command, Composite)

actor "Player" as P
boundary "__:SwingGameView__" as V
control "__:GameController__" as GC
participant "__:CommandFactory__" as CF
participant "__:RulesEngine__" as RE
participant "__take : TakeCommand__" as C
participant "__:GameState__" as GS
participant "__location : Location__" as L
participant "__player : Player__" as PL
participant "__inventory : Inventory__" as INV
participant "__root : Container__" as ROOT
participant "__pouch : Container__" as POUCH
participant "__potion : Consumable__" as POT
participant "__ironKey : KeyItem__" as KEY

P -> V : select "iron key" in the location panel,\nclick "Take"
V -> GC : performAction(proposal)
note right of V : proposal = new ActionProposal(TAKE, "iron key", null);\nbuttons skip the LLM (no interpret(), no narrate())
GC -> CF : create(proposal)
CF -->> GC : take
GC -> RE : executeAll([take], state)
ref over RE, GS : SD03 — mode check: allows(TAKE) is false in combat
RE -> C : validate(state)
  C -> GS : currentLocation()
  GS -->> C : location
  C -> L : findItem("iron key")
  L -->> C : ironKey
  C -> GS : getPlayer()
  GS -->> C : player
  C -> PL : getInventory()
  PL -->> C : inventory
  C -> INV : canCarry(ironKey)
    INV -> INV : totalWeight()
      INV -> ROOT : getWeight()
        loop for each item in root's contents
          ROOT -> POUCH : getWeight()
          note right : Composite: a Container adds its own weight to\ngetWeight() of everything inside it, at any depth;\na leaf (Weapon, Consumable, KeyItem) returns its own weight
            loop for each item in pouch's contents
              POUCH -> POT : getWeight()
              POT -->> POUCH : weight
            end
          POUCH -->> ROOT : weight
        end
      ROOT -->> INV : total
    INV -->> INV : total
    INV -> KEY : getWeight()
    KEY -->> INV : keyWeight
  INV -->> C : total + keyWeight ≤ maxWeight
C -->> RE : validation
note right of RE : invalid if the item is not in the location\nor too heavy ("You carry 9.5 of 10 kg.")
alt validation.isValid()
  RE -> C : execute(state, rules)
    C -> L : removeItem("iron key")
    L -->> C : ironKey
    C -> INV : add(ironKey)
      INV -> ROOT : add(ironKey)
      ROOT -->> INV : added
    INV -->> C : added
    C -> KEY : getOwnerId()
    KEY -->> C : ownerId
    note right of C : ownerId = null here; if the item belongs to an NPC who is\nnot handing it over in a conversation, the ITEM event\nrecords a theft (alignment delta −2)
  C -->> RE : result : ActionResult (ITEM event "took the iron key")
  ref over RE : SD03 — the ITEM event is published (SD05):\nquests advance and the inventory panel refreshes
else invalid
  RE -> RE : reject(take, validation.getReason())
  RE -->> RE : result
end
RE -->> GC : results
GC -> V : showNarration(text)
note right of GC : text = the results' messages (getMessage()),\nso a button turn needs no LLM
V -->> GC
GC -->> V : turnResult
V -->> P
@enduml
