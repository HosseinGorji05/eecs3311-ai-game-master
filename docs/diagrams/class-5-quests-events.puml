@startuml class-5-quests-events
!include style.iuml
skinparam linetype ortho
set separator none
title Class Diagram 5 — Quests, Events and Persistence (Observer, Memento)

package "engine.core" {
  class GameState <<Model>> <<Originator>> <<Context>>
}
package "engine.quests" {
  class QuestLog {
    - {static} MAX_SIDE_QUESTS: int = 3
    - quests: List<Quest>
    --
    + accept(quest: Quest): boolean
    + activeQuests(): List<Quest>
    + activeSideQuestCount(): int
    + hasQuestFrom(giver: NPC): boolean
    + canOfferFrom(giver: NPC): boolean
    --
    <i>{activeSideQuestCount() ≤ MAX_SIDE_QUESTS}</i>
  }
  class Quest {
    - id: String
    - title: String
    - description: String
    - giverId: String
    - main: boolean
    - status: QuestStatus
    - objectives: List<Objective>
    - reward: Reward
    + getObjectives(): List<Objective>
    + getReward(): Reward
    + isComplete(): boolean
    + complete()
    + fail()
  }
  class Objective {
    - type: ObjectiveType
    - targetId: String
    - required: int
    - progress: int
    + matches(event: GameEvent): boolean
    + isBlockedBy(event: GameEvent): boolean
    + advance()
    + isDone(): boolean
  }
  class Reward {
    - gold: int
    - xp: int
    - itemName: String
  }
  class QuestTracker <<ConcreteObserver>> {
    - state: GameState
    - eventBus: GameEventBus
    + onEvent(event: GameEvent)
  }
  enum QuestStatus <<enumeration>> {
    ACTIVE
    COMPLETED
    FAILED
  }
  enum ObjectiveType <<enumeration>> {
    FETCH
    DEFEAT
    VISIT
  }
}
package "engine.events" {
  interface GameEventListener <<interface>> <<Observer>> {
    + onEvent(event: GameEvent)
  }
  class GameEventBus <<Subject>> {
    - listeners: List<GameEventListener>
    + subscribe(listener: GameEventListener)
    + unsubscribe(listener: GameEventListener)
    + publish(event: GameEvent)
  }
  class GameEvent {
    - type: EventType
    - turn: int
    - timestamp: Instant
    - description: String
    - subjectId: String
    - alignmentDelta: int
    + GameEvent(type: EventType, turn: int, description: String, subjectId: String, alignmentDelta: int)
    + getType(): EventType
    + getTurn(): int
    + getDescription(): String
    + getAlignmentDelta(): int
  }
  class EventLog <<ConcreteObserver>> {
    - events: List<GameEvent>
    + onEvent(event: GameEvent)
    + filter(type: EventType): List<GameEvent>
    + recent(count: int): List<GameEvent>
    - append(event: GameEvent)
  }
  enum EventType <<enumeration>> {
    MOVEMENT
    ITEM
    COMBAT
    DIALOGUE
    QUEST
    REJECTED
  }
}
package "engine.persistence" {
  class GameSnapshot <<Memento>> {
    - {static} CURRENT_VERSION: int = 1
    - version: int
    - createdAt: Instant
    - characterName: String
    - locationName: String
    - stateJson: String
    + GameSnapshot(stateJson: String, characterName: String, locationName: String)
    + {static} fromJson(json: String): GameSnapshot
    + toJson(): String
    + isCompatible(): boolean
    + toSlotInfo(slot: String): SaveSlotInfo
  }
  class SaveManager <<Caretaker>> {
    - saveDirectory: Path
    + save(slot: String, snapshot: GameSnapshot)
    + load(slot: String): GameSnapshot
    + listSlots(): List<SaveSlotInfo>
  }
  class SaveSlotInfo {
    - slot: String
    - characterName: String
    - locationName: String
    - savedAt: Instant
    + SaveSlotInfo(slot: String, characterName: String, locationName: String, savedAt: Instant)
  }
}
package "agent" {
  class MemoryManager <<ConcreteObserver>>
}

GameState "1" *-- "1" QuestLog
GameState "1" *-- "1" EventLog
GameState ..> GameSnapshot : <<create>>
QuestLog "0..1" *-- "0..*" Quest
Quest "0..1" *-- "1..3" Objective
Quest "0..1" *-- "1" Reward
Quest "0..*" --> "1" QuestStatus
Objective "0..*" --> "1" ObjectiveType
Objective ..> GameEvent : <<use>>
QuestTracker "0..1" --> "1" GameState : updates quests of
QuestTracker "0..1" --> "1" GameEventBus : publishes to
QuestTracker ..> QuestLog : <<use>>
QuestTracker ..> Quest : <<use>>
QuestTracker ..> Objective : <<use>>
GameEventListener <|.. QuestTracker
GameEventListener <|.. EventLog
GameEventListener <|.. MemoryManager
GameEventBus "1" o-- "0..*" GameEventListener : notifies
GameEventBus ..> GameEvent : <<send>>
EventLog "1" o-- "0..*" GameEvent
GameEvent "0..*" --> "1" EventType
SaveManager ..> GameSnapshot : <<create>>
SaveManager ..> SaveSlotInfo
GameSnapshot ..> SaveSlotInfo : <<create>>
legend right
Classes shown as a name only are detailed in another view.
endlegend
@enduml
