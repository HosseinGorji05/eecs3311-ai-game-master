@startuml sd11-move
!include seq-style.iuml
title SD11 — Move to an Adjacent Location through a Locked Door (UC06, F06; Command, Observer)

actor "Player" as P
boundary "__:SwingGameView__" as V
control "__:GameController__" as GC
participant "__:CommandFactory__" as CF
participant "__:RulesEngine__" as RE
participant "__move : MoveCommand__" as C
participant "__:GameState__" as GS
participant "__location : Location__" as L
participant "__door : Exit__" as E
participant "__player : Player__" as PL
participant "__inventory : Inventory__" as INV
participant "__shed : Location__" as D

P -> V : click "Tool Shed" on the map
V -> GC : performAction(proposal)
note right of V : proposal = new ActionProposal(MOVE, "Tool Shed", null);\na typed "go east" arrives through SD02 with target "east"
GC -> CF : create(proposal)
CF -->> GC : move
note right of CF : destinationName = "Tool Shed"\n(for "go east": direction = EAST)
GC -> RE : executeAll([move], state)
ref over RE, GS : SD03 — mode check: allows(MOVE) is false in combat and dialogue
RE -> C : validate(state)
  C -> GS : currentLocation()
  GS -->> C : location
  alt destinationName is set
    C -> L : findExitTo("Tool Shed")
    L -->> C : door
  else direction is set
    C -> L : getExit(EAST)
    L -->> C : door
  end
  C -> E : isLocked()
  E -->> C : locked
  opt locked
    C -> E : getRequiredKeyName()
    E -->> C : keyName
    C -> GS : getPlayer()
    GS -->> C : player
    C -> PL : getInventory()
    PL -->> C : inventory
    C -> INV : find(keyName)
    INV -->> C : key (null if not carried)
  end
  note right of C : the command keeps door and key\nin its exit and key fields for execute()
C -->> RE : validation
note right of RE : invalid if door is null (no exit that way, or the\ndestination is not adjacent: the exits are listed),\nor the door is locked and key is null ("You need the shed key.")
alt validation.isValid()
  RE -> C : execute(state, rules)
    opt locked
      C -> E : unlock(key)
      E -->> C : unlocked
    end
    C -> E : getDestination()
    E -->> C : shed
    C -> GS : setCurrentLocation(shed)
    GS -->> C
    C -> D : markVisited()
    D -->> C
  C -->> RE : result : ActionResult (MOVEMENT event)
  ref over RE : SD03 — the MOVEMENT event is published (SD05):\nSwingGameView.onEvent() calls refresh(), which redraws the map
else invalid
  RE -> RE : reject(move, validation.getReason())
  RE -->> RE : result
end
RE -->> GC : results
GC -> V : showNarration(text)
note right of GC : text = the results' messages, e.g. the shed's\ndescription, items, NPCs and exits (no LLM)
V -->> GC
GC -->> V : turnResult
V -->> P
@enduml
