  class EndingWriter <<ConcreteClass>> {
    + write(ending: Ending): String
    # buildPrompt(input: Ending): LlmRequest
    # parse(response: LlmResponse): String
    # isValid(output: String, input: Ending): boolean
    # fallback(input: Ending): String
  }
  class PromptBuilder {
    - memory: MemoryManager
    - templates: Map<String, String>
    + stateSummary(state: GameState): String
    + memoryContext(focus: String, maxChars: int): String
    + fromTemplate(name: String, vars: Map<String, String>): String
  }
  class ResponseParser {
    + parseJson<T>(text: String, type: Class<T>): T
  }
  class OfflineFallbackParser {
    + parse(text: String): List<ActionProposal>
  }
  class QuestValidator {
    - world: World
    + validate(proposal: QuestProposal): ValidationResult
  }
  class QuestProposal {
    - title: String
    - description: String
    - objectives: List<Objective>
    - reward: Reward
  }
  class NpcReply {
    - text: String
    - sideEffect: ActionProposal
    + getText(): String
    + getSideEffect(): ActionProposal
  }
  class MemoryManager <<ConcreteObserver>> {
    - {static} SUMMARIZE_THRESHOLD: int = 20
    - state: GameState
    - summarizer: MemorySummarizer
    + onEvent(event: GameEvent)
    + buildContext(focus: String, maxChars: int): String
    + journalText(): String
    - isKeyFact(event: GameEvent): boolean
  }
}
package "llm" {
  interface LLMClient <<interface>> <<Strategy>> <<Target>> {
    + complete(request: LlmRequest): LlmResponse
    + isAvailable(): boolean
    + providerName(): String
  }
  abstract class OpenAiCompatibleClient <<Adapter>> {
    - baseUrl: String
    - model: String
    - apiKey: String
    - http: HttpClient
    # OpenAiCompatibleClient(baseUrl: String, model: String, apiKey: String)
    + complete(request: LlmRequest): LlmResponse
    + isAvailable(): boolean
    + {abstract} providerName(): String
    # toHttpRequest(request: LlmRequest): HttpRequest
    # toLlmResponse(response: HttpResponse<String>): LlmResponse
  }
  class DeepSeekClient <<ConcreteStrategy>> {
    + DeepSeekClient(apiKey: String)
    + providerName(): String
  }
  class GroqClient <<ConcreteStrategy>> {
    + GroqClient(apiKey: String)
    + providerName(): String
  }
  class ScriptedLLMClient <<ConcreteStrategy>> {
    - responses: Queue<String>
    + ScriptedLLMClient(responses: List<String>)
    + complete(request: LlmRequest): LlmResponse
    + isAvailable(): boolean
    + providerName(): String
  }
  class LlmRequest {
    - systemPrompt: String
    - userPrompt: String
    - jsonMode: boolean
    - maxTokens: int
  }
  class LlmResponse {
    - text: String
    - ok: boolean
    - error: String
    + getText(): String
    + isOk(): boolean
  }
}
package "java.net.http" {
  abstract class HttpClient <<Adaptee>> <<library>> {
    + {abstract} send<T>(request: HttpRequest, handler: BodyHandler<T>): HttpResponse<T>
  }
}

