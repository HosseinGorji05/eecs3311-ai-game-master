package "agent" {
  abstract class "LlmTask<I, O>" as LlmTask <<AbstractClass>> <<Context>> {
    # {static} MAX_ATTEMPTS: int = 2
    # llm: LLMClient
    # prompts: PromptBuilder
    # parser: ResponseParser
    # state: GameState
    - fallbackUsed: boolean
    + run(input: I): O {leaf}
    + isFallbackUsed(): boolean
    # {abstract} buildPrompt(input: I): LlmRequest
    # {abstract} parse(response: LlmResponse): O
    # {abstract} isValid(output: O, input: I): boolean
    # {abstract} fallback(input: I): O
  }
  class ActionInterpreter <<ConcreteClass>> {
    - offlineParser: OfflineFallbackParser
    + interpret(text: String): List<ActionProposal>
    # buildPrompt(input: String): LlmRequest
    # parse(response: LlmResponse): List<ActionProposal>
    # isValid(output: List<ActionProposal>, input: String): boolean
    # fallback(input: String): List<ActionProposal>
