@startuml class-3-commands
!include style.iuml
skinparam linetype ortho
set separator none
title Class Diagram 3 — Game Commands (Command)

package "engine.core" {
  class ExplorationMode <<ConcreteState>>
  class CombatMode <<ConcreteState>>
  class DialogueMode <<ConcreteState>>
  class RulesEngine <<Invoker>>
}
package "engine.commands" {
  interface GameCommand <<interface>> <<Command>> {
    + getType(): ActionType
    + validate(state: GameState): ValidationResult
    + execute(state: GameState, rules: RulesEngine): ActionResult
  }
  class MoveCommand <<ConcreteCommand>> {
    - direction: Direction
    - destinationName: String
    - exit: Exit
    - key: KeyItem
    + getType(): ActionType
    + validate(state: GameState): ValidationResult
    + execute(state: GameState, rules: RulesEngine): ActionResult
  }
  class TakeCommand <<ConcreteCommand>> {
    - itemName: String
    + getType(): ActionType
    + validate(state: GameState): ValidationResult
    + execute(state: GameState, rules: RulesEngine): ActionResult
  }
  class DropCommand <<ConcreteCommand>> {
    - itemName: String
    + getType(): ActionType
    + validate(state: GameState): ValidationResult
    + execute(state: GameState, rules: RulesEngine): ActionResult
  }
  class PutCommand <<ConcreteCommand>> {
    - itemName: String
    - containerName: String
    + getType(): ActionType
    + validate(state: GameState): ValidationResult
    + execute(state: GameState, rules: RulesEngine): ActionResult
  }
  class UseItemCommand <<ConcreteCommand>> {
    - itemName: String
    + getType(): ActionType
    + validate(state: GameState): ValidationResult
    + execute(state: GameState, rules: RulesEngine): ActionResult
  }
  class EquipCommand <<ConcreteCommand>> {
    - itemName: String
    + getType(): ActionType
    + validate(state: GameState): ValidationResult
    + execute(state: GameState, rules: RulesEngine): ActionResult
  }
  class TalkCommand <<ConcreteCommand>> {
    - npcName: String
    + getType(): ActionType
    + validate(state: GameState): ValidationResult
    + execute(state: GameState, rules: RulesEngine): ActionResult
  }
  class LeaveCommand <<ConcreteCommand>> {
    + getType(): ActionType
    + validate(state: GameState): ValidationResult
    + execute(state: GameState, rules: RulesEngine): ActionResult
  }
  class AttackCommand <<ConcreteCommand>> {
    - targetName: String
    + getType(): ActionType
    + validate(state: GameState): ValidationResult
    + execute(state: GameState, rules: RulesEngine): ActionResult
  }
  class FleeCommand <<ConcreteCommand>> {
    - {static} DIFFICULTY: int = 12
    + getType(): ActionType
    + validate(state: GameState): ValidationResult
    + execute(state: GameState, rules: RulesEngine): ActionResult
  }
  class LookCommand <<ConcreteCommand>> {
    + getType(): ActionType
    + validate(state: GameState): ValidationResult
    + execute(state: GameState, rules: RulesEngine): ActionResult
  }
  class InventoryCommand <<ConcreteCommand>> {
    + getType(): ActionType
    + validate(state: GameState): ValidationResult
    + execute(state: GameState, rules: RulesEngine): ActionResult
  }
  class CommandFactory {
    + create(proposal: ActionProposal): GameCommand
  }
  class ActionProposal {
    - type: ActionType
    - target: String
    - secondTarget: String
    + ActionProposal(type: ActionType, target: String, secondTarget: String)
    + getType(): ActionType
    + getTarget(): String
    + getSecondTarget(): String
  }
  class ActionResult {
    - success: boolean
    - message: String
    - events: List<GameEvent>
    + ActionResult(success: boolean, message: String)
    + addEvent(event: GameEvent)
    + getMessage(): String
    + getEvents(): List<GameEvent>
  }
  class ValidationResult {
    - valid: boolean
    - reason: String
    + ValidationResult(valid: boolean, reason: String)
    + isValid(): boolean
    + getReason(): String
  }
  enum ActionType <<enumeration>> {
    MOVE
    TAKE
    DROP
    PUT
    USE
    EQUIP
    TALK
    LEAVE
    ATTACK
    FLEE
    LOOK
    INVENTORY
  }
}
package "engine.world" {
  enum Direction <<enumeration>>
}
package "engine.events" {
  class GameEvent
}

AttackCommand ..> CombatMode : <<create>>
AttackCommand ..> ExplorationMode : <<create>>
FleeCommand ..> ExplorationMode : <<create>>
FleeCommand ..> CombatMode : <<use>>
UseItemCommand ..> CombatMode : <<use>>
LeaveCommand ..> ExplorationMode : <<create>>
TalkCommand ..> DialogueMode : <<create>>
GameCommand <|.. MoveCommand
GameCommand <|.. TakeCommand
GameCommand <|.. DropCommand
GameCommand <|.. PutCommand
GameCommand <|.. UseItemCommand
GameCommand <|.. EquipCommand
GameCommand <|.. TalkCommand
GameCommand <|.. LeaveCommand
GameCommand <|.. AttackCommand
GameCommand <|.. FleeCommand
GameCommand <|.. LookCommand
GameCommand <|.. InventoryCommand
GameCommand ..> ValidationResult
GameCommand ..> ActionResult
GameCommand ..> ActionType
CommandFactory ..> GameCommand : <<create>>
CommandFactory ..> ActionProposal : <<use>>
MoveCommand "0..*" --> "0..1" Direction
ActionResult "0..1" o-- "0..*" GameEvent
ActionProposal "0..*" --> "1" ActionType
RulesEngine ..> GameCommand : <<call>>
RulesEngine ..> ActionResult : <<create>>
legend right
Classes shown as a name only are detailed in another view.
endlegend
MoveCommand -[hidden]down- UseItemCommand
UseItemCommand -[hidden]down- AttackCommand
TakeCommand -[hidden]down- EquipCommand
EquipCommand -[hidden]down- FleeCommand
DropCommand -[hidden]down- TalkCommand
TalkCommand -[hidden]down- LookCommand
PutCommand -[hidden]down- LeaveCommand
LeaveCommand -[hidden]down- InventoryCommand
@enduml
