  <element>
    <id>UMLClass</id>
    <coordinates><x>100</x><y>260</y><w>250</w><h>160</h></coordinates>
    <panel_attributes>&lt;&lt;interface&gt;&gt;
&lt;&lt;View&gt;&gt;
/*GameView*/
--
+ render(state: GameState)
+ showNarration(text: String)
+ showNotice(text: String)
+ showError(message: String)
+ showQuestOffer(quest: Quest)
+ showEnding(ending: Ending)</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>100</x><y>480</y><w>250</w><h>410</h></coordinates>
    <panel_attributes>&lt;&lt;View&gt;&gt;
*SwingGameView*
--
- controller: GameController
- frame: JFrame
- newGamePanel: JPanel
- storyArea: JTextArea
- inputField: JTextField
- mapPanel: JPanel
- inventoryTree: JTree
- questList: JList&lt;Quest&gt;
- eventTable: JTable
- journalArea: JTextArea
- dialoguePanel: JPanel
- combatPanel: JPanel
- saveDialog: JDialog
- endPanel: JPanel
--
+ render(state: GameState)
+ showNarration(text: String)
+ showNotice(text: String)
+ showError(message: String)
+ showQuestOffer(quest: Quest)
+ showEnding(ending: Ending)
+ onEvent(event: GameEvent)
- refresh()</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>450</x><y>260</y><w>250</w><h>250</h></coordinates>
    <panel_attributes>&lt;&lt;View&gt;&gt;
*CliGameView*
--
- controller: GameController
- in: Scanner
- out: PrintStream
--
+ readLoop()
- dispatch(line: String)
+ render(state: GameState)
+ showNarration(text: String)
+ showNotice(text: String)
+ showError(message: String)
+ showQuestOffer(quest: Quest)
+ showEnding(ending: Ending)
+ onEvent(event: GameEvent)</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLNote</id>
    <coordinates><x>920</x><y>260</y><w>320</w><h>50</h></coordinates>
