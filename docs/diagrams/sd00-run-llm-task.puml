@startuml sd00-run-llm-task
!include seq-style.iuml
title SD00 — Run an LLM Task (Template Method, Strategy, Adapter)\nreferenced by SD01, SD02, SD06, SD07, SD09

participant "__task : LlmTask__" as T
participant "__:PromptBuilder__" as PB
participant "__:MemoryManager__" as MM
participant "__llm : DeepSeekClient__" as LLM
participant "__:HttpClient__" as HTTP
participant "DeepSeek API\n(LLM Service)" as SVC <<external system>>
participant "__:ResponseParser__" as RP

note over T : task is any LlmTask subclass, e.g. ActionInterpreter.\nIt is entered from the subclass's public method (interpret(),\nnarrate(), reply(), generate(), write(), summarize()), which\ncalls run(input). run() is the template method; buildPrompt,\nparse, isValid and fallback are supplied by the subclass.
note over LLM : llm is the LLMClient strategy,\nhere bound to DeepSeekClient\n(GroqClient works the same way)

[-> T : run(input)
T -> T : buildPrompt(input)
  T -> PB : stateSummary(state)
  PB -->> T : summary
  T -> PB : memoryContext(focus, maxChars)
    note right : focus = what the prompt is about (the NPC's id,\nthe current location's id, ...): fixed facts and\nsummaries that mention it are picked first
    PB -> MM : buildContext(focus, maxChars)
    MM -->> PB : context
  PB -->> T : context
  T -> PB : fromTemplate(name, vars)
  PB -->> T : promptText
T -->> T : request

loop attempt ≤ MAX_ATTEMPTS and no valid output yet
  T -> LLM : isAvailable()
  LLM -->> T : available
  opt available
    T -> LLM : complete(request)
      LLM -> LLM : toHttpRequest(request)
      LLM -->> LLM : httpRequest
      LLM -> HTTP : send(httpRequest, handler)
        HTTP -> SVC : POST /chat/completions
        SVC -->> HTTP : JSON body
      HTTP -->> LLM : httpResponse
      LLM -> LLM : toLlmResponse(httpResponse)
      LLM -->> LLM : response
    LLM -->> T : response
    opt response.isOk() (no network error or timeout)
      T -> T : parse(response)
        T -> RP : parseJson(response.getText(), type)
        RP -->> T : output
      T -->> T : output
      opt output is not null (well-formed JSON)
        T -> T : isValid(output, input)
        T -->> T : valid
      end
    end
  end
end

opt no valid output: LLM unavailable, timeout, malformed JSON or invalid twice
  T -> T : fallback(input)
  note right : deterministic fallback, e.g.\nOfflineFallbackParser, template text\nor a pre-written NPC line;\nrun() sets fallbackUsed = true
  T -->> T : output
end
[<<-- T : output
@enduml
