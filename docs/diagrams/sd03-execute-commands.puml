@startuml sd03-execute-commands
!include seq-style.iuml
title SD03 — Execute Game Commands (Command, State)\nreferenced by SD02, SD04, SD07 and SD10–SD12

participant "__:RulesEngine__" as RE
participant "__:GameState__" as GS
participant "__mode : GameMode__" as M
participant "__command : GameCommand__" as C
participant "__:GameEventBus__" as BUS

[-> RE : executeAll(commands, state)
loop for each command in commands
  RE -> C : getType()
  C -->> RE : type
  RE -> GS : allows(type)
    GS -> M : allows(type)
    note right : GameState delegates to its\ncurrent mode (State pattern)
    M -->> GS : allowed
  GS -->> RE : allowed
  alt not allowed in the current mode
    RE -> RE : reject(command, "not possible right now")
      RE -> BUS : publish(rejected)
      note right : rejected : GameEvent of type REJECTED
      BUS -->> RE
    RE -->> RE : result
  else allowed
    RE -> C : validate(state)
    C -->> RE : validation : ValidationResult
    alt validation.isValid()
      RE -> C : execute(state, rules)
      note right : expanded in SD10 (TakeCommand), SD11 (MoveCommand),\nSD04 (AttackCommand) and SD12 (FleeCommand, LeaveCommand)
      C -->> RE : result : ActionResult
      loop for each event in result.getEvents()
        RE -> BUS : publish(event)
        ref over BUS : SD05 — Propagate Game Events
        BUS -->> RE
      end
    else invalid: unknown item, blocked exit, cheat attempt
      RE -> RE : reject(command, validation.getReason())
        RE -> BUS : publish(rejected)
        BUS -->> RE
      RE -->> RE : result
    end
  end
end
RE -> GS : nextTurn()
GS -->> RE
[<<-- RE : results : List<ActionResult>
@enduml
