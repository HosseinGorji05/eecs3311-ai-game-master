&lt;&lt;Context&gt;&gt;
/*LlmTask&lt;I, O&gt;*/
--
_# MAX_ATTEMPTS: int = 2_
# llm: LLMClient
# prompts: PromptBuilder
# parser: ResponseParser
# state: GameState
- fallbackUsed: boolean
--
+ run(input: I): O {leaf}
+ isFallbackUsed(): boolean
/# buildPrompt(input: I): LlmRequest/
/# parse(response: LlmResponse): O/
/# isValid(output: O, input: I): boolean/
/# fallback(input: I): O/</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
