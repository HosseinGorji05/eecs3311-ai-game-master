*EndingWriter*
--
+ write(ending: Ending): String
# buildPrompt(input: Ending): LlmRequest
# parse(response: LlmResponse): String
# isValid(output: String, input: Ending): boolean
# fallback(input: Ending): String</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLNote</id>
    <coordinates><x>1340</x><y>120</y><w>350</w><h>210</h></coordinates>
    <panel_attributes>bg=#FFFDE7
run(input):  // template method, {leaf} = final
  fallbackUsed = false
  request = buildPrompt(input)
  repeat up to MAX_ATTEMPTS times:
    if llm.isAvailable():
      response = llm.complete(request)
      if response.isOk():
        output = parse(response)
        if output != null and isValid(output, input):
          return output
  fallbackUsed = true
  return fallback(input)</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
