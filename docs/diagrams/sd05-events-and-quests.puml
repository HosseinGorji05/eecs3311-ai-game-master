@startuml sd05-events-and-quests
!include seq-style.iuml
title SD05 — Propagate Game Events and Track Quests (UC08, F08, F11; Observer)\nreferenced by SD03, SD04, SD07

participant "__:GameEventBus__" as BUS
participant "__:EventLog__" as EL
participant "__:QuestTracker__" as QT
participant "__:GameState__" as GS
participant "__:QuestLog__" as QL
participant "__quest : Quest__" as Q
participant "__objective : Objective__" as O
participant "__player : Player__" as PL
participant "__:MemoryManager__" as MM
boundary "__:SwingGameView__" as V

[-> BUS : publish(event)
note over BUS : notifies every subscribed\nGameEventListener in turn
BUS -> EL : onEvent(event)
  EL -> EL : append(event)
  EL -->> EL
EL -->> BUS
BUS -> QT : onEvent(event)
  QT -> GS : getQuestLog()
  GS -->> QT : questLog
  QT -> QL : activeQuests()
  QL -->> QT : quests
  loop for each quest in quests
    QT -> Q : getObjectives()
    Q -->> QT : objectives
    loop for each objective in objectives
      QT -> O : matches(event)
      O -->> QT : matched
      opt matched
        QT -> O : advance()
        O -->> QT
      end
      QT -> O : isBlockedBy(event)
      O -->> QT : blocked
      note right : e.g. the potion a FETCH\nobjective asks for was used up
    end
    QT -> Q : isComplete()
    Q -->> QT : complete
    alt an objective is blocked
      QT -> Q : fail()
      Q -->> QT
      QT -> BUS : publish(questFailed)
      note right : QUEST event, alignment\ndelta −1 (side quests only)
      BUS -->> QT
    else complete
      QT -> Q : complete()
      Q -->> QT
      QT -> Q : getReward()
      Q -->> QT : reward
      QT -> GS : getPlayer()
      GS -->> QT : player
      QT -> PL : addReward(reward)
      PL -->> QT
      QT -> BUS : publish(questCompleted)
      note right : QUEST event; alignment delta +2 for a side\nquest (the player helped its giver), 0 for the\nmain quest; delivered to all listeners the same way
      BUS -->> QT
    end
  end
QT -->> BUS
BUS -> MM : onEvent(event)
ref over MM : SD06 — update\nstory memory
MM -->> BUS
BUS -> V : onEvent(event)
  V -> V : refresh()
  note left : redraws the map, inventory,\nquest log and event log panels
  V -->> V
V -->> BUS
[<<-- BUS
@enduml
