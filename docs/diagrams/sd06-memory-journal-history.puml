@startuml sd06-memory-journal-history
!include seq-style.iuml
title SD06 — Story Memory, Journal and Event History (UC09, UC12; F09, F11)

actor "Player" as P
boundary "__:SwingGameView__" as V
control "__:GameController__" as GC
participant "__:MemoryManager__" as MM
participant "__:GameState__" as GS
participant "__memory : StoryMemory__" as SM
participant "__:EventLog__" as EL
participant "__:MemorySummarizer__" as MS
participant "__llm : LLMClient__" as LLM

== Update story memory (every published event, from SD05) ==
[-> MM : onEvent(event)
MM -> GS : getStoryMemory()
GS -->> MM : memory
MM -> SM : record(event)
SM -->> MM
MM -> MM : isKeyFact(event)
MM -->> MM : keyFact
opt keyFact: a death, a quest outcome, or any event\nwith a non-zero alignment delta (e.g. a theft)
  MM -> SM : addFixedFact(event.getDescription())
  SM -->> MM
end
MM -> SM : recentCount()
SM -->> MM : count
opt count > SUMMARIZE_THRESHOLD
  MM -> SM : takeOldest(10)
  SM -->> MM : oldest
  MM -> MS : summarize(oldest)
    MS -> MS : run(oldest)
    ref over MS, LLM : SD00 — Run an LLM Task\n(isValid: summary does not contradict the fixed facts;\nfallback: the events' own descriptions, joined)
    MS -->> MS : summary
  MS -->> MM : summary
  MM -> SM : addSummary(summary)
  SM -->> MM
end
[<<-- MM

== Review journal (UC09) ==
P -> V : open the Journal tab
V -> GC : getJournal()
GC -> MM : journalText()
  MM -> GS : getStoryMemory()
  GS -->> MM : memory
  MM -> SM : getFixedFacts()
  SM -->> MM : facts
  MM -> SM : getSummaries()
  SM -->> MM : summaries
  MM -> SM : getRecentEvents()
  SM -->> MM : recent
MM -->> GC : text
GC -->> V : journal
V -->> P : journal shown

== View event history (UC12) ==
P -> V : choose filter "COMBAT"
V -> GC : getHistory(COMBAT)
GC -> GS : getEventLog()
GS -->> GC : log
GC -> EL : filter(COMBAT)
EL -->> GC : events
GC -->> V : events
V -->> P : filtered events shown
@enduml
