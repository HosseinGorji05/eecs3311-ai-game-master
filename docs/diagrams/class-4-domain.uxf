  <element>
    <id>UMLClass</id>
    <coordinates><x>420</x><y>120</y><w>210</w><h>170</h></coordinates>
    <panel_attributes>/*Combatant*/
--
# name: String
# hp: int
# maxHp: int
--
+ takeDamage(amount: int)
+ isAlive(): boolean
/+ attackBonus(): int/
/+ defense(): int/
/+ damage(): int/</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>130</x><y>360</y><w>570</w><h>330</h></coordinates>
    <panel_attributes>*Player*
--
- characterClass: CharacterClass
- stats: Stats
- inventory: Inventory
- equippedWeapon: Weapon
- gold: int
- xp: int
- backstory: String
--
+ Player(name: String, cls: CharacterClass, stats: Stats, hp: int, kit: List&lt;Item&gt;)
+ getStats(): Stats
+ getInventory(): Inventory
+ getLevel(): int
+ attackBonus(): int
+ defense(): int
+ damage(): int
+ heal(amount: int)
+ equip(weapon: Weapon)
+ setBackstory(text: String)
+ addReward(reward: Reward)</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>760</x><y>460</y><w>160</w><h>120</h></coordinates>
    <panel_attributes>*Enemy*
--
- attack: int
- defenseRating: int
--
+ attackBonus(): int
+ defense(): int
+ damage(): int</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>130</x><y>760</y><w>380</w><h>220</h></coordinates>
    <panel_attributes>*Stats*
--
_- TOTAL_POINTS: int = 10_
_- MIN: int = 1_
_- MAX: int = 8_
- strength: int
- agility: int
- intelligence: int
--
+ Stats(strength: int, agility: int, intelligence: int)
+ isValid(): boolean
+ modifier(stat: StatType): int
--
/{strength + agility + intelligence = TOTAL_POINTS}/
/{MIN ≤ strength, agility, intelligence ≤ MAX}/</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
