  <element>
    <id>UMLClass</id>
    <coordinates><x>1440</x><y>120</y><w>250</w><h>170</h></coordinates>
    <panel_attributes>*Inventory*
--
- maxWeight: double
- root: Container
--
+ add(item: Item): boolean
+ remove(name: String): Item
+ find(name: String): Item
+ canCarry(item: Item): boolean
+ totalWeight(): double
--
/{totalWeight() ≤ maxWeight}/</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>1760</x><y>120</y><w>180</w><h>180</h></coordinates>
    <panel_attributes>&lt;&lt;Component&gt;&gt;
&lt;&lt;Product&gt;&gt;
/*Item*/
--
