    <panel_attributes>*Location*
--
- id: String
- name: String
- description: String
- visited: boolean
- exits: List&lt;Exit&gt;
- items: List&lt;Item&gt;
- npcs: List&lt;NPC&gt;
- enemies: List&lt;Enemy&gt;
--
+ getExit(dir: Direction): Exit
+ findExitTo(locationName: String): Exit
+ findItem(name: String): Item
+ addItem(item: Item)
+ removeItem(name: String): Item
+ findNpc(name: String): NPC
+ findEnemy(name: String): Enemy
+ removeEnemy(enemy: Enemy)
+ markVisited()</panel_attributes>
    <additional_attributes></additional_attributes>
