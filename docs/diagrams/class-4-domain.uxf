  <element>
    <id>UMLClass</id>
    <coordinates><x>1800</x><y>370</y><w>470</w><h>190</h></coordinates>
    <panel_attributes>&lt;&lt;Composite&gt;&gt;
*Container*
--
- capacity: int
- contents: List&lt;Item&gt;
--
+ add(item: Item): boolean
+ remove(item: Item): boolean
+ getContents(): List&lt;Item&gt;
+ getWeight(): double
--
/{getWeight() = weight + sum of item.getWeight() over contents}/
/{a container cannot contain itself}/</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
