' Shared style for AI Game Master sequence diagrams (UML 2 notation, as in the EECS3311 UML II slides)
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam BackgroundColor #FFFFFF
skinparam ArrowColor #333333
skinparam SequenceLifeLineBorderColor #777777
skinparam SequenceLifeLineBackgroundColor #FFFFFF
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #333333
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #333333
skinparam SequenceGroupBorderColor #555555
skinparam SequenceGroupHeaderFontStyle bold
skinparam SequenceGroupBackgroundColor #F2F2F2
skinparam SequenceReferenceBackgroundColor #F7F7F7
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #B0A060
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam SequenceMessageAlign left
skinparam ResponseMessageBelowArrow true
skinparam style strictuml
hide footbox
autoactivate on
