  <element>
    <id>UMLClass</id>
    <coordinates><x>680</x><y>300</y><w>270</w><h>100</h></coordinates>
    <panel_attributes>&lt;&lt;interface&gt;&gt;
&lt;&lt;State&gt;&gt;
/*GameMode*/
--
+ allows(type: ActionType): boolean
+ canSave(): boolean</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>100</x><y>510</y><w>380</w><h>120</h></coordinates>
    <panel_attributes>&lt;&lt;ConcreteState&gt;&gt;
*ExplorationMode*
--
--
+ ExplorationMode()
+ allows(type: ActionType): boolean
+ canSave(): boolean
--
/{allows every ActionType except FLEE and LEAVE}/</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>530</x><y>490</y><w>420</w><h>160</h></coordinates>
    <panel_attributes>&lt;&lt;ConcreteState&gt;&gt;
*CombatMode*
--
- enemy: Enemy
--
+ CombatMode(enemy: Enemy)
+ getEnemy(): Enemy
+ allows(type: ActionType): boolean
+ canSave(): boolean
--
/{allows ATTACK, FLEE, USE, EQUIP, LOOK, INVENTORY}/</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>1000</x><y>470</y><w>530</w><h>200</h></coordinates>
    <panel_attributes>&lt;&lt;ConcreteState&gt;&gt;
*DialogueMode*
--
- npc: NPC
- questOffered: boolean
--
+ DialogueMode(npc: NPC)
+ getNpc(): NPC
+ isQuestOffered(): boolean
+ setQuestOffered()
+ allows(type: ActionType): boolean
+ canSave(): boolean
--
/{allows LEAVE, TAKE (an item the NPC hands over), LOOK, INVENTORY}/</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>1610</x><y>300</y><w>310</w><h>490</h></coordinates>
    <panel_attributes>&lt;&lt;Model&gt;&gt;
&lt;&lt;Originator&gt;&gt;
&lt;&lt;Context&gt;&gt;
*GameState*
--
- turn: int
- player: Player
- world: World
- currentLocation: Location
- mode: GameMode
- questLog: QuestLog
- eventLog: EventLog
- storyMemory: StoryMemory
--
+ start(player: Player, world: World)
+ getTurn(): int
+ getPlayer(): Player
+ getWorld(): World
+ currentLocation(): Location
+ setCurrentLocation(location: Location)
+ getMode(): GameMode
+ setMode(mode: GameMode)
+ allows(type: ActionType): boolean
+ canSave(): boolean
+ getQuestLog(): QuestLog
+ getEventLog(): EventLog
+ getStoryMemory(): StoryMemory
+ nextTurn()
+ isGameOver(): boolean
+ createSnapshot(): GameSnapshot
+ restore(snapshot: GameSnapshot)</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>390</x><y>890</y><w>630</w><h>150</h></coordinates>
    <panel_attributes>&lt;&lt;Invoker&gt;&gt;
*RulesEngine*
--
- dice: DiceRoller
- eventBus: GameEventBus
--
+ executeAll(commands: List&lt;GameCommand&gt;, state: GameState): List&lt;ActionResult&gt;
+ resolveAttack(attacker: Combatant, target: Combatant): ActionResult
+ skillCheck(statValue: int, difficulty: int): boolean
- reject(command: GameCommand, reason: String): ActionResult</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>1080</x><y>920</y><w>190</w><h>90</h></coordinates>
    <panel_attributes>*DiceRoller*
--
- random: Random
--
+ DiceRoller(seed: long)
+ rollD20(): int</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>1330</x><y>860</y><w>300</w><h>220</h></coordinates>
    <panel_attributes>*StoryMemory*
--
- fixedFacts: List&lt;String&gt;
- summaries: List&lt;String&gt;
- recentEvents: List&lt;GameEvent&gt;
--
+ record(event: GameEvent)
+ addFixedFact(fact: String)
+ recentCount(): int
+ takeOldest(n: int): List&lt;GameEvent&gt;
+ addSummary(summary: String)
+ getFixedFacts(): List&lt;String&gt;
+ getSummaries(): List&lt;String&gt;
+ getRecentEvents(): List&lt;GameEvent&gt;</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>430</x><y>1170</y><w>430</w><h>80</h></coordinates>
    <panel_attributes>*EndingCalculator*
--
+ alignmentScore(log: EventLog): int
+ determineType(state: GameState, score: int): EndingType
+ statistics(log: EventLog): Map&lt;String, Integer&gt;</panel_attributes>
    <additional_attributes></additional_attributes>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>920</x><y>1150</y><w>450</w><h>120</h></coordinates>
