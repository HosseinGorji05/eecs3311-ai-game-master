@startuml sd08-save-load
!include seq-style.iuml
title SD08 — Save and Load Game (UC10, UC11; F10; Memento)

actor "Player" as P
boundary "__:SwingGameView__" as V
control "__:GameController__" as GC
participant "__:GameState__" as GS
participant "__mode : GameMode__" as M
participant "__snapshot : GameSnapshot__" as SN
participant "__:SaveManager__" as SM
participant "GameSnapshot" as GSC <<static>>
participant "__loaded : GameSnapshot__" as SN2
participant "File System" as FS <<external system>>

== Save (UC10) ==
P -> V : click "Save", enter a slot name
V -> GC : listSaves()
GC -> SM : listSlots()
SM -->> GC : slots
note right of SM : one SaveSlotInfo per file: slot, character\nname, location and time (GameSnapshot.toSlotInfo())
GC -->> V : slots
opt slot name already exists
  V -> P : ask to confirm overwrite
  P -->> V : confirm or cancel
end
alt new slot name, or overwrite confirmed
  V -> GC : saveGame(slot)
  GC -> GS : canSave()
    GS -> M : canSave()
    M -->> GS : canSave
  GS -->> GC : canSave
  alt canSave is false (in combat)
    GC -> V : showError("You can't save during combat.")
    V -->> GC
  else canSave
    GC -> GS : createSnapshot()
      GS -> SN ** : <<create>> GameSnapshot(stateJson, characterName, locationName)
    GS -->> GC : snapshot
    GC -> SM : save(slot, snapshot)
      SM -> SN : toJson()
      SN -->> SM : json
      SM -> FS : Files.writeString(path, json)
      FS -->> SM
    SM -->> GC : (or throws IOException)
    alt write failed (IOException, UC10 4a)
      GC -> V : showError("Could not save: " + message)
      note right : the game continues unchanged
      V -->> GC
    else saved
      GC -> V : showNotice("Game saved.")
      V -->> GC
    end
  end
  GC -->> V
else player cancels the overwrite
  note over V : nothing is saved
end
V -->> P

== Load (UC11) ==
P -> V : choose a slot, click "Load"
V -> GC : loadGame(slot)
GC -> SM : load(slot)
  SM -> FS : Files.readString(path)
  FS -->> SM : json
  SM -> GSC : fromJson(json)
    note right of GSC : static factory: reads version, createdAt,\ncharacterName, locationName and stateJson;\ninvalid JSON is reported as an IOException
    GSC -> SN2 ** : <<create>> GameSnapshot(stateJson, characterName, locationName)
  GSC -->> SM : loaded
SM -->> GC : loaded (or throws IOException)
alt file missing, unreadable or not valid JSON (IOException)
  GC -> V : showError(message)
  note right : the current game is left untouched
  V -->> GC
else file read
  GC -> SN2 : isCompatible()
  SN2 -->> GC : compatible
  alt not compatible (other version)
    GC -> V : showError(message)
    V -->> GC
  else compatible
    GC -> GS : restore(loaded)
    note right : reloads player, world, quests, event log and\nstory memory into the existing objects, so\nobservers and agents keep valid references
    GS -->> GC
    GC -> V : render(state)
    V -->> GC
  end
end
GC -->> V
V -->> P
@enduml
