@startuml class-full
!include style.iuml
skinparam linetype ortho
set separator none
title Complete Class Diagram — AI Game Master (all classes, attributes, operations and relationships)

package "presentation" {
  interface GameView <<interface>> <<View>> {
    + render(state: GameState)
    + showNarration(text: String)
    + showNotice(text: String)
    + showError(message: String)
    + showQuestOffer(quest: Quest)
    + showEnding(ending: Ending)
  }
  class SwingGameView <<View>> {
    - controller: GameController
    - frame: JFrame
    - newGamePanel: JPanel
    - storyArea: JTextArea
    - inputField: JTextField
    - mapPanel: JPanel
    - inventoryTree: JTree
    - questList: JList<Quest>
    - eventTable: JTable
    - journalArea: JTextArea
    - dialoguePanel: JPanel
    - combatPanel: JPanel
    - saveDialog: JDialog
    - endPanel: JPanel
    + render(state: GameState)
    + showNarration(text: String)
    + showNotice(text: String)
    + showError(message: String)
    + showQuestOffer(quest: Quest)
    + showEnding(ending: Ending)
    + onEvent(event: GameEvent)
    - refresh()
  }
  class CliGameView <<View>> {
    - controller: GameController
    - in: Scanner
    - out: PrintStream
    + readLoop()
    - dispatch(line: String)
    + render(state: GameState)
    + showNarration(text: String)
    + showNotice(text: String)
    + showError(message: String)
    + showQuestOffer(quest: Quest)
    + showEnding(ending: Ending)
    + onEvent(event: GameEvent)
  }
  class GameApp {
    + {static} main(args: String[])
    - {static} createLlmClient(provider: String): LLMClient
  }
  class GameController <<Controller>> <<Facade>> {
    - state: GameState
    - views: List<GameView>
    - rules: RulesEngine
    - commandFactory: CommandFactory
    - eventBus: GameEventBus
    - saves: SaveManager
    - memory: MemoryManager
    - endingCalculator: EndingCalculator
    - interpreter: ActionInterpreter
    - narrator: Narrator
    - dialogueAgent: NpcDialogueAgent
    - questGenerator: QuestGenerator
    - backstoryWriter: BackstoryWriter
    - endingWriter: EndingWriter
    + GameController(llm: LLMClient)
    + addView(view: GameView)
    + getState(): GameState
    + newGame(name: String, cls: CharacterClass, stats: Stats): Player
    + regenerateBackstory(): String
    + startGame()
    + submitCommand(text: String): TurnResult
    + performAction(proposal: ActionProposal): TurnResult
    + sendDialogue(message: String): NpcReply
    + respondToQuest(quest: Quest, accept: boolean)
    + saveGame(slot: String)
    + loadGame(slot: String)
    + listSaves(): List<SaveSlotInfo>
    + getJournal(): String
    + getHistory(filter: EventType): List<GameEvent>
    + getRecentHistory(count: int): List<GameEvent>
    + endGame(): Ending
  }
  class TurnResult {
    - narration: String
    - results: List<ActionResult>
    - gameOver: boolean
    + TurnResult(narration: String, results: List<ActionResult>, gameOver: boolean)
  }
}
package "engine.core" {
  class GameState <<Model>> <<Originator>> <<Context>> {
    - turn: int
    - player: Player
    - world: World
    - currentLocation: Location
    - mode: GameMode
    - questLog: QuestLog
    - eventLog: EventLog
    - storyMemory: StoryMemory
    + start(player: Player, world: World)
    + getTurn(): int
    + getPlayer(): Player
    + getWorld(): World
    + currentLocation(): Location
    + setCurrentLocation(location: Location)
    + getMode(): GameMode
    + setMode(mode: GameMode)
    + allows(type: ActionType): boolean
    + canSave(): boolean
    + getQuestLog(): QuestLog
    + getEventLog(): EventLog
    + getStoryMemory(): StoryMemory
    + nextTurn()
    + isGameOver(): boolean
    + createSnapshot(): GameSnapshot
    + restore(snapshot: GameSnapshot)
  }
  interface GameMode <<interface>> <<State>> {
    + allows(type: ActionType): boolean
    + canSave(): boolean
  }
  class ExplorationMode <<ConcreteState>> {
    --
    + ExplorationMode()
    + allows(type: ActionType): boolean
    + canSave(): boolean
    --
    <i>{allows every ActionType except FLEE and LEAVE}</i>
  }
  class CombatMode <<ConcreteState>> {
    - enemy: Enemy
    --
    + CombatMode(enemy: Enemy)
    + getEnemy(): Enemy
    + allows(type: ActionType): boolean
    + canSave(): boolean
    --
    <i>{allows ATTACK, FLEE, USE, EQUIP, LOOK, INVENTORY}</i>
  }
  class DialogueMode <<ConcreteState>> {
    - npc: NPC
    - questOffered: boolean
    --
    + DialogueMode(npc: NPC)
    + getNpc(): NPC
    + isQuestOffered(): boolean
    + setQuestOffered()
    + allows(type: ActionType): boolean
    + canSave(): boolean
    --
    <i>{allows LEAVE, TAKE (an item the NPC hands over), LOOK, INVENTORY}</i>
  }
  class StoryMemory {
    - fixedFacts: List<String>
    - summaries: List<String>
    - recentEvents: List<GameEvent>
    + record(event: GameEvent)
    + addFixedFact(fact: String)
    + recentCount(): int
    + takeOldest(n: int): List<GameEvent>
    + addSummary(summary: String)
    + getFixedFacts(): List<String>
    + getSummaries(): List<String>
    + getRecentEvents(): List<GameEvent>
  }
  class RulesEngine <<Invoker>> {
    - dice: DiceRoller
    - eventBus: GameEventBus
    + executeAll(commands: List<GameCommand>, state: GameState): List<ActionResult>
    + resolveAttack(attacker: Combatant, target: Combatant): ActionResult
    + skillCheck(statValue: int, difficulty: int): boolean
    - reject(command: GameCommand, reason: String): ActionResult
  }
  class DiceRoller {
    - random: Random
    + DiceRoller(seed: long)
    + rollD20(): int
  }
  class EndingCalculator {
    + alignmentScore(log: EventLog): int
    + determineType(state: GameState, score: int): EndingType
    + statistics(log: EventLog): Map<String, Integer>
  }
  class Ending {
    - type: EndingType
    - statistics: Map<String, Integer>
    - epilogue: String
    + Ending(type: EndingType, statistics: Map<String, Integer>)
    + setEpilogue(text: String)
  }
  enum EndingType <<enumeration>> {
    HEROIC
    NEUTRAL
    DARK
    DEATH
  }
}
package "engine.commands" {
  interface GameCommand <<interface>> <<Command>> {
    + getType(): ActionType
    + validate(state: GameState): ValidationResult
    + execute(state: GameState, rules: RulesEngine): ActionResult
  }
  class MoveCommand <<ConcreteCommand>> {
    - direction: Direction
    - destinationName: String
    - exit: Exit
    - key: KeyItem
    + getType(): ActionType
    + validate(state: GameState): ValidationResult
    + execute(state: GameState, rules: RulesEngine): ActionResult
  }
  class TakeCommand <<ConcreteCommand>> {
    - itemName: String
    + getType(): ActionType
    + validate(state: GameState): ValidationResult
    + execute(state: GameState, rules: RulesEngine): ActionResult
  }
  class DropCommand <<ConcreteCommand>> {
    - itemName: String
    + getType(): ActionType
    + validate(state: GameState): ValidationResult
    + execute(state: GameState, rules: RulesEngine): ActionResult
  }
  class PutCommand <<ConcreteCommand>> {
    - itemName: String
    - containerName: String
    + getType(): ActionType
    + validate(state: GameState): ValidationResult
    + execute(state: GameState, rules: RulesEngine): ActionResult
  }
  class UseItemCommand <<ConcreteCommand>> {
    - itemName: String
    + getType(): ActionType
    + validate(state: GameState): ValidationResult
    + execute(state: GameState, rules: RulesEngine): ActionResult
  }
  class EquipCommand <<ConcreteCommand>> {
    - itemName: String
    + getType(): ActionType
    + validate(state: GameState): ValidationResult
    + execute(state: GameState, rules: RulesEngine): ActionResult
  }
  class TalkCommand <<ConcreteCommand>> {
    - npcName: String
    + getType(): ActionType
    + validate(state: GameState): ValidationResult
    + execute(state: GameState, rules: RulesEngine): ActionResult
  }
  class LeaveCommand <<ConcreteCommand>> {
    + getType(): ActionType
    + validate(state: GameState): ValidationResult
    + execute(state: GameState, rules: RulesEngine): ActionResult
  }
  class AttackCommand <<ConcreteCommand>> {
    - targetName: String
    + getType(): ActionType
    + validate(state: GameState): ValidationResult
    + execute(state: GameState, rules: RulesEngine): ActionResult
  }
  class FleeCommand <<ConcreteCommand>> {
    - {static} DIFFICULTY: int = 12
    + getType(): ActionType
    + validate(state: GameState): ValidationResult
    + execute(state: GameState, rules: RulesEngine): ActionResult
  }
  class LookCommand <<ConcreteCommand>> {
    + getType(): ActionType
    + validate(state: GameState): ValidationResult
    + execute(state: GameState, rules: RulesEngine): ActionResult
  }
  class InventoryCommand <<ConcreteCommand>> {
    + getType(): ActionType
    + validate(state: GameState): ValidationResult
    + execute(state: GameState, rules: RulesEngine): ActionResult
  }
  class CommandFactory {
    + create(proposal: ActionProposal): GameCommand
  }
  class ActionProposal {
    - type: ActionType
    - target: String
    - secondTarget: String
    + ActionProposal(type: ActionType, target: String, secondTarget: String)
    + getType(): ActionType
    + getTarget(): String
    + getSecondTarget(): String
  }
  class ActionResult {
    - success: boolean
    - message: String
    - events: List<GameEvent>
    + ActionResult(success: boolean, message: String)
    + addEvent(event: GameEvent)
    + getMessage(): String
    + getEvents(): List<GameEvent>
  }
  class ValidationResult {
    - valid: boolean
    - reason: String
    + ValidationResult(valid: boolean, reason: String)
    + isValid(): boolean
    + getReason(): String
  }
  enum ActionType <<enumeration>> {
    MOVE
    TAKE
    DROP
    PUT
    USE
    EQUIP
    TALK
    LEAVE
    ATTACK
    FLEE
    LOOK
    INVENTORY
  }
}
package "engine.character" {
  abstract class Combatant {
    # name: String
    # hp: int
    # maxHp: int
    + takeDamage(amount: int)
    + isAlive(): boolean
    + {abstract} attackBonus(): int
    + {abstract} defense(): int
    + {abstract} damage(): int
  }
  class Player {
    - characterClass: CharacterClass
    - stats: Stats
    - inventory: Inventory
    - equippedWeapon: Weapon
    - gold: int
    - xp: int
    - backstory: String
    + Player(name: String, cls: CharacterClass, stats: Stats, hp: int, kit: List<Item>)
    + getStats(): Stats
    + getInventory(): Inventory
    + getLevel(): int
    + attackBonus(): int
    + defense(): int
    + damage(): int
    + heal(amount: int)
    + equip(weapon: Weapon)
    + setBackstory(text: String)
    + addReward(reward: Reward)
  }
  class Enemy {
    - attack: int
    - defenseRating: int
    + attackBonus(): int
    + defense(): int
    + damage(): int
  }
  class Stats {
    - {static} TOTAL_POINTS: int = 10
    - {static} MIN: int = 1
    - {static} MAX: int = 8
    - strength: int
    - agility: int
    - intelligence: int
    --
    + Stats(strength: int, agility: int, intelligence: int)
    + isValid(): boolean
    + modifier(stat: StatType): int
    --
    <i>{strength + agility + intelligence = TOTAL_POINTS}</i>
    <i>{MIN ≤ strength, agility, intelligence ≤ MAX}</i>
  }
  enum StatType <<enumeration>> {
    STRENGTH
    AGILITY
    INTELLIGENCE
  }
  enum CharacterClass <<enumeration>> {
    WARRIOR
    ROGUE
    MAGE
  }
  abstract class CharacterFactory <<Creator>> {
    + {static} forClass(cls: CharacterClass): CharacterFactory
    + createCharacter(name: String, stats: Stats): Player
    # {abstract} baseHp(): int
    # {abstract} createStartingKit(): List<Item>
  }
  class WarriorFactory <<ConcreteCreator>> {
    # baseHp(): int
    # createStartingKit(): List<Item>
  }
  class RogueFactory <<ConcreteCreator>> {
    # baseHp(): int
    # createStartingKit(): List<Item>
  }
  class MageFactory <<ConcreteCreator>> {
    # baseHp(): int
    # createStartingKit(): List<Item>
  }
}
package "engine.items" {
  class Inventory {
    - maxWeight: double
    - root: Container
    --
    + add(item: Item): boolean
    + remove(name: String): Item
    + find(name: String): Item
    + canCarry(item: Item): boolean
    + totalWeight(): double
    --
    <i>{totalWeight() ≤ maxWeight}</i>
  }
  abstract class Item <<Component>> <<Product>> {
    # name: String
    # weight: double
    # ownerId: String
    + getName(): String
    + getOwnerId(): String
    + {abstract} getWeight(): double
    + describe(): String
  }
  class Weapon <<Leaf>> <<ConcreteProduct>> {
    - damage: int
    + getDamage(): int
    + getWeight(): double
  }
  class Consumable <<Leaf>> <<ConcreteProduct>> {
    - healAmount: int
    + getHealAmount(): int
    + getWeight(): double
  }
  class KeyItem <<Leaf>> <<ConcreteProduct>> {
    + getWeight(): double
  }
  class Container <<Composite>> {
    - capacity: int
    - contents: List<Item>
    --
    + add(item: Item): boolean
    + remove(item: Item): boolean
    + getContents(): List<Item>
    + getWeight(): double
    --
    <i>{getWeight() = weight + sum of item.getWeight() over contents}</i>
    <i>{a container cannot contain itself}</i>
  }
}
package "engine.world" {
  class World {
    - regions: List<Region>
    - startLocation: Location
    + {static} createDefault(): World
    + findLocation(id: String): Location
    + getStartLocation(): Location
    + summarize(): String
  }
  class Region {
    - name: String
    - locations: List<Location>
  }
  class Location {
    - id: String
    - name: String
    - description: String
    - visited: boolean
    - exits: List<Exit>
    - items: List<Item>
    - npcs: List<NPC>
    - enemies: List<Enemy>
    + getExit(dir: Direction): Exit
    + findExitTo(locationName: String): Exit
    + findItem(name: String): Item
    + addItem(item: Item)
    + removeItem(name: String): Item
    + findNpc(name: String): NPC
    + findEnemy(name: String): Enemy
    + removeEnemy(enemy: Enemy)
    + markVisited()
  }
  class Exit {
    - id: String
    - direction: Direction
    - destination: Location
    - locked: boolean
    - requiredKeyName: String
    + getDestination(): Location
    + getRequiredKeyName(): String
    + isLocked(): boolean
    + unlock(key: KeyItem): boolean
  }
  enum Direction <<enumeration>> {
    NORTH
    SOUTH
    EAST
    WEST
  }
  class NPC {
    - id: String
    - name: String
    - role: String
    - personality: String
    - knowledge: List<String>
    - secrets: List<String>
    - questGiver: boolean
    + getId(): String
    + isQuestGiver(): boolean
  }
}
package "engine.quests" {
  class QuestLog {
    - {static} MAX_SIDE_QUESTS: int = 3
    - quests: List<Quest>
    --
    + accept(quest: Quest): boolean
    + activeQuests(): List<Quest>
    + activeSideQuestCount(): int
    + hasQuestFrom(giver: NPC): boolean
    + canOfferFrom(giver: NPC): boolean
    --
    <i>{activeSideQuestCount() ≤ MAX_SIDE_QUESTS}</i>
  }
  class Quest {
    - id: String
    - title: String
    - description: String
    - giverId: String
    - main: boolean
    - status: QuestStatus
    - objectives: List<Objective>
    - reward: Reward
    + getObjectives(): List<Objective>
    + getReward(): Reward
    + isComplete(): boolean
    + complete()
    + fail()
  }
  class Objective {
    - type: ObjectiveType
    - targetId: String
    - required: int
    - progress: int
    + matches(event: GameEvent): boolean
    + isBlockedBy(event: GameEvent): boolean
    + advance()
    + isDone(): boolean
  }
  class Reward {
    - gold: int
    - xp: int
    - itemName: String
  }
  class QuestTracker <<ConcreteObserver>> {
    - state: GameState
    - eventBus: GameEventBus
    + onEvent(event: GameEvent)
  }
  enum QuestStatus <<enumeration>> {
    ACTIVE
    COMPLETED
    FAILED
  }
  enum ObjectiveType <<enumeration>> {
    FETCH
    DEFEAT
    VISIT
  }
}
package "engine.events" {
  interface GameEventListener <<interface>> <<Observer>> {
    + onEvent(event: GameEvent)
  }
  class GameEventBus <<Subject>> {
    - listeners: List<GameEventListener>
    + subscribe(listener: GameEventListener)
    + unsubscribe(listener: GameEventListener)
    + publish(event: GameEvent)
  }
  class GameEvent {
    - type: EventType
    - turn: int
    - timestamp: Instant
    - description: String
    - subjectId: String
    - alignmentDelta: int
    + GameEvent(type: EventType, turn: int, description: String, subjectId: String, alignmentDelta: int)
    + getType(): EventType
    + getTurn(): int
    + getDescription(): String
    + getAlignmentDelta(): int
  }
  class EventLog <<ConcreteObserver>> {
    - events: List<GameEvent>
    + onEvent(event: GameEvent)
    + filter(type: EventType): List<GameEvent>
    + recent(count: int): List<GameEvent>
    - append(event: GameEvent)
  }
  enum EventType <<enumeration>> {
    MOVEMENT
    ITEM
    COMBAT
    DIALOGUE
    QUEST
    REJECTED
  }
}
package "engine.persistence" {
  class GameSnapshot <<Memento>> {
    - {static} CURRENT_VERSION: int = 1
    - version: int
    - createdAt: Instant
    - characterName: String
    - locationName: String
    - stateJson: String
    + GameSnapshot(stateJson: String, characterName: String, locationName: String)
    + {static} fromJson(json: String): GameSnapshot
    + toJson(): String
    + isCompatible(): boolean
    + toSlotInfo(slot: String): SaveSlotInfo
