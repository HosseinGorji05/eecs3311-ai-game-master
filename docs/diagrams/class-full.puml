package "llm" {
  interface LLMClient <<interface>> <<Strategy>> <<Target>> {
    + complete(request: LlmRequest): LlmResponse
    + isAvailable(): boolean
    + providerName(): String
  }
  abstract class OpenAiCompatibleClient <<Adapter>> {
    - baseUrl: String
    - model: String
    - apiKey: String
    - http: HttpClient
    # OpenAiCompatibleClient(baseUrl: String, model: String, apiKey: String)
    + complete(request: LlmRequest): LlmResponse
    + isAvailable(): boolean
    + {abstract} providerName(): String
    # toHttpRequest(request: LlmRequest): HttpRequest
    # toLlmResponse(response: HttpResponse<String>): LlmResponse
  }
  class DeepSeekClient <<ConcreteStrategy>> {
    + DeepSeekClient(apiKey: String)
    + providerName(): String
  }
  class GroqClient <<ConcreteStrategy>> {
    + GroqClient(apiKey: String)
    + providerName(): String
  }
  class ScriptedLLMClient <<ConcreteStrategy>> {
    - responses: Queue<String>
    + ScriptedLLMClient(responses: List<String>)
    + complete(request: LlmRequest): LlmResponse
    + isAvailable(): boolean
    + providerName(): String
  }
  class LlmRequest {
    - systemPrompt: String
    - userPrompt: String
    - jsonMode: boolean
    - maxTokens: int
  }
  class LlmResponse {
    - text: String
    - ok: boolean
    - error: String
    + getText(): String
    + isOk(): boolean
  }
}
package "java.net.http" {
  abstract class HttpClient <<Adaptee>> <<library>> {
    + {abstract} send<T>(request: HttpRequest, handler: BodyHandler<T>): HttpResponse<T>
  }
}
GameView <|.. SwingGameView
GameView <|.. CliGameView
SwingGameView "0..*" --> "1" GameController : forwards input
CliGameView "0..*" --> "1" GameController : forwards input
GameController "1" --> "1..*" GameView : updates
GameController "1" *-- "1" GameState
GameController "1" --> "1" RulesEngine
GameController "1" --> "1" CommandFactory
GameController "1" --> "1" GameEventBus
GameController "1" --> "1" SaveManager
GameController "1" --> "1" MemoryManager
GameController "1" --> "1" EndingCalculator
GameController "1" --> "1" ActionInterpreter
GameController "1" --> "1" Narrator
GameController "1" --> "1" NpcDialogueAgent
GameController "1" --> "1" QuestGenerator
GameController "1" --> "1" BackstoryWriter
GameController "1" --> "1" EndingWriter
GameController ..> CharacterFactory : <<use>>
GameController ..> World : <<use>>
GameController ..> Stats : <<use>>
