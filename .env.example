# Copy this file to .env and fill in your own values. Never commit .env.
# Environment variables with the same names override the values in .env.
# A value left as YOUR_LOCAL_API_KEY_HERE counts as not set, so the game plays offline.

# deepseek (default), groq or offline
LLM_PROVIDER=deepseek

# Key for the provider you use; leave the others as they are.
DEEPSEEK_API_KEY=YOUR_LOCAL_API_KEY_HERE
GROQ_API_KEY=YOUR_LOCAL_API_KEY_HERE

# Optional: used for either provider when its own key above is not set.
LLM_API_KEY=YOUR_LOCAL_API_KEY_HERE
